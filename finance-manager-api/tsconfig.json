{
  "compilerOptions": {
    "target": "ES6",                     
    "module": "commonjs",                 
    "moduleResolution": "node",           
    "esModuleInterop": true,               
    "strict": true,                       
    "skipLibCheck": true,                 
    "forceConsistentCasingInFileNames": true,  
    "resolveJsonModule": true,          
    "outDir": "./dist",                    
    "rootDir": "./src",                  
    "esModuleInterop": true,              
    "allowJs": true                       
  },
  "include": ["src/**/*.ts"],               
  "exclude": ["node_modules"]                
}
