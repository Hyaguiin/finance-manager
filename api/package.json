{
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  
  "scripts": {
    "dev": "concurrently \"npm run auth-api\" \"npm run finance-api\" \"npm run reports-and-analysis-api\"",
    "auth-api": "nodemon --exec ts-node ./auth-api/server.ts",
    "finance-api": "nodemon --exec ts-node ./finance-api/server.ts",
    "reports-and-analysis-api": "nodemon --exec ts-node ./reports-and-analysis-api/server.ts"
  },

  "dependencies": {
    "uuid": "^11.1.0"
  }
}
